venv/
.venv/
env/
.env/
.spec/
.env.*
!.env.example

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# Test, coverage, and type-checking
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.pyre/
.ruff_cache/
.hypothesis/

# Logs and local data
*.log
*.sqlite
*.sqlite3

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# PyInstaller
*.manifest
*.spec.bak

# Temporary files
*.tmp
*.temp
*.bak
*.orig